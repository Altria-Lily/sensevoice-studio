# Inference
FUNASR_DEVICE=auto
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_SPK_MODEL=cam++
FUNASR_MAX_SEGMENT_MS=30000
FUNASR_BATCH_SIZE_S=60
FUNASR_MERGE_LENGTH_S=15

# Storage (relative paths are resolved from the project directory)
FUNASR_DATA_DIR=data
FUNASR_MODEL_DIR=data/models
FUNASR_MAX_UPLOAD_MB=10240
FUNASR_JOB_WORKERS=1

# Optional: path to an ffmpeg executable. If omitted, the app uses the
# system ffmpeg or the binary bundled by imageio-ffmpeg.
# FFMPEG_BINARY=C:\\ffmpeg\\bin\\ffmpeg.exe
